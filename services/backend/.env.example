DATABASE_URL=postgresql+psycopg://tripadapt:tripadapt@127.0.0.1:5432/tripadapt
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SUPABASE_URL=https://your-project.supabase.co
AUTH_AUDIENCE=authenticated

# Local planning rehearsal only; no model/provider calls.
PLANNING_FIXTURES_ENABLED=false

# Server-only Groq configuration. Never use a NEXT_PUBLIC prefix for the key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
PLANNING_AI_ENABLED=false

# Explicit Open-Meteo/GeoNames searches for non-commercial local evaluation.
PLACE_SEARCH_ENABLED=false

# Explicit OSM/Overpass research for local evaluation only, not production capacity.
ACTIVITY_SEARCH_ENABLED=false

# Optional hosted place discovery; secret stays in this backend only.
# auto selects Geoapify when a key exists, otherwise the explicit Overpass trial.
GEOAPIFY_API_KEY=
ACTIVITY_PLACES_PROVIDER=auto

# Optional on-demand Google Places checks. Keep this backend-only and IP/API restricted.
GOOGLE_MAPS_API_KEY=

# Optional separate Routes API key; otherwise GOOGLE_MAPS_API_KEY must allow Routes API.
ROUTES_API_KEY=
